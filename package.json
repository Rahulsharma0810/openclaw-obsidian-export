{
  "name": "openclaw-obsidian-export",
  "version": "1.0.4",
  "description": "Auto-saves every OpenClaw session transcript to an Obsidian vault with no LLM tokens, plus an on-demand agent-authored summary export.",
  "type": "module",
  "license": "MIT",
  "author": "Rahulsharma0810",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "obsidian",
    "transcript",
    "session",
    "memory",
    "export"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rahulsharma0810/openclaw-obsidian-export.git"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.4"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "openclaw": {
    "extensions": ["./dist/index.js"],
    "compat": {
      "pluginApi": ">=2026.9.4",
      "minGatewayVersion": "2026.9.4"
    },
    "build": {
      "openclawVersion": "2026.9.4",
      "pluginSdkVersion": "2026.9.4"
    }
  }
}
